<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= car.make %> <%= car.model %> - Details</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
  <style>
    body { 
      background: linear-gradient(135deg, #2e3b4e, #1c2530); 
      color: #fff; 
    }
    .car-details { 
      padding: 2rem; 
    }
    .car-image { 
      width: 100%; 
      height: auto; 
    }
    .close-btn {
      background-color: transparent;
      border: none;
      font-size: 30px;
      color: #fff;
      cursor: pointer;
      transition: transform 0.3s ease, color 0.3s ease;
    }
    .close-btn:hover {
      color: #dc3545; /* Bootstrap's red color */
      transform: scale(1.2); /* Enlarges the button on hover */
    }
    .close-btn:focus {
      outline: none;
    }
  </style>
</head>
<body>
  <div class="container car-details">
    <!-- Close Button (styled with Bootstrap) -->
    <button class="close-btn" onclick="window.location='<%= backUrl %>';">&times;</button>

    <h1 class="my-4"><%= car.make %> <%= car.model %> (<%= car.year %>)</h1>
    <img src="<%= car.imagePath || 'placeholder.jpg' %>" class="car-image mb-3" alt="<%= car.make %> <%= car.model %>">
    
    <div class="row mb-3">
      <div class="col-md-4">
        <strong>Fuel Type:</strong> <%= car.fuelType %>
      </div>
      <div class="col-md-4">
        <strong>Price:</strong> $<%= car.price %>
      </div>
      <div class="col-md-4">
        <strong>Mileage:</strong> <%= car.mileage %> miles
      </div>
    </div>

    <div class="row">
      <div class="col-md-12">
        <strong>Description:</strong> <%= car.description %>
      </div>
    </div>
  </div>
</body>
</html>
